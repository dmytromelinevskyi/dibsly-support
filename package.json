{
  "name": "dibsly-site",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "generate:features": "python3 scripts/content/features.py .",
    "generate:legal": "python3 scripts/content/legal.py .",
    "format": "prettier --write src scripts tests vite.config.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"scripts/**/*.mjs\" \"tests/*.js\" vite.config.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "gsap": "3.12.5",
    "lenis": "1.1.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  }
}
