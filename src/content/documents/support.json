        "tag": "section",
        "attrs": { "class": "section", "id": "privacy" },
        "children": [
          {
            "tag": "div",
            "attrs": { "class": "wrap" },
            "children": [
              { "tag": "h2", "attrs": { "class": "reveal" }, "children": ["Your data"] },
