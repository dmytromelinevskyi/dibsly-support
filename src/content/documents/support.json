  "head": "<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<title>Dibsly Support</title>\n<meta name=\"description\" content=\"Dibsly support: Free and Premium, backups, imports, your data and how to reach us.\">\n<meta name=\"theme-color\" content=\"#0E0C0B\">\n<link rel=\"canonical\" href=\"https://dibslyapp.com/support.html\">\n<link rel=\"alternate\" hreflang=\"uk\" href=\"https://dibslyapp.com/support-uk.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://dibslyapp.com/support.html\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:site_name\" content=\"Dibsly\">\n<meta property=\"og:title\" content=\"Dibsly Support\">\n<meta property=\"og:description\" content=\"Dibsly support: Free and Premium, backups, imports, your data and how to reach us.\">\n<meta property=\"og:url\" content=\"https://dibslyapp.com/support.html\">\n<meta property=\"og:image\" content=\"https://dibslyapp.com/assets/screenshots/web/en-web.jpg\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"icon\" type=\"image/png\" href=\"assets/brand/favicon.png\">\n<link rel=\"apple-touch-icon\" href=\"assets/brand/apple-touch-icon.png\">",
