  "actions": [
    {
      "time": 1793272373.592,
      "text": "Відкрий план із головного екрана."
    },
    {
      "time": 1793272395.105,
      "text": "Кольори одразу показують залишок і перевитрату. Торкнися категорії."
    },
    {
      "time": 1793272400.419,
      "text": "Можна взяти фактичні витрати за основу ліміту."
    },
    {
      "time": 1793272406.728,
      "text": "Збережи зміни — категорія одразу перерахується."
    }
  ]
